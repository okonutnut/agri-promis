"use client";

import { Button } from "@/components/ui/button";
import { Download, Printer, Loader2 } from "lucide-react";
import type { TDocumentDefinitions } from "pdfmake/interfaces";
import {  useState } from "react";

export async function getPdfMake() {
  const pdfMakeModule = await import("pdfmake/build/pdfmake");
  const pdfMake = pdfMakeModule.default;
  return pdfMake;
}

// Type definitions for the travel report data
export type TravelReportEntry = {
  travelOrderNo: string;
  inclusiveDates: string;
  projectPlacesVisited: string;
  activitiesUndertaken: string;
  issuesConcerns: string;
  remarksRecommendation?: string;
};

export type TravelReportSignatures = {
  preparedBy: {
    name: string;
    title: string;
  };
  reviewedBy: {
    name: string;
    title: string;
  };
  recommendingApproval: {
    name: string;
    title: string;
  };
  approvedBy: {
    name: string;
    title: string;
  };
};

export type PostTravelReportData = {
  documentCode?: string;
  effectivityDate?: string;
  revNo?: string;
  entries: TravelReportEntry[];
  signatures: TravelReportSignatures;
  images?: string[]; // Array of image URLs
  projectTitle?: string;
  location?: string;
  iccFcaLguName?: string;
};

// Helper function to convert image to base64
async function getImageBase64(src: string): Promise<string> {
  try {
    const response = await fetch(src);
    const blob = await response.blob();
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onloadend = () => {
        const base64 = reader.result as string;
        resolve(base64);
      };
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  } catch (error) {
    console.error("Error loading image:", error);
    return "";
  }
}

// Generate PDF document definition
async function generatePostTravelReportPDF(
  data: PostTravelReportData
): Promise<TDocumentDefinitions> {
  // Load logo image
  const logoImage = await getImageBase64("/printing/image1.png");
  
  // Load uploaded images if they exist
  const uploadedImages: string[] = [];
  if (data.images && data.images.length > 0) {
    for (const imageUrl of data.images) {
      if (imageUrl) {
        const imageBase64 = await getImageBase64(imageUrl);
        if (imageBase64) {
          uploadedImages.push(imageBase64);
        }
      }
    }
  }

  // Table body for travel entries - matching template.js structure
  const tableBody: any[] = [
    // First header row with full text
    [
      {
        text: "TRAVEL ORDER \n NO.",
        alignment: "center",
        margin: [0, 8, 0, 0],
        border: [true, true, true, false],
      },
      {
        text: "INCLUSIVE \n DATE(S) \n OF \n TRAVEL",
        alignment: "center",
        border: [true, true, true, false],
      },
      {
        text: "PROJECT/ \n PLACES \n VISITED \n (Sto./Brgy/Mun/Prov)",
        alignment: "center",
        border: [true, true, true, false],
      },
      {
        text: "ACTIVITIES UNDERTAKEN \n (Pls. Capsulized, quantify, & \n indicate appropriate \n parameters / indicators)",
        alignment: "center",
        border: [true, true, true, false],
      },
      {
        text: "ISSUES/CONCERN/PROJECT \n % ACCOMPLISHMENT TO DATE",
        alignment: "center",
        border: [true, true, true, false],
      },
      {
        text: "REMARKS/RECOMENDATION",
        alignment: "center",
        border: [true, true, true, false],
      },
    ],
    // Second header row with numbers
    [
      {
        text: "(1)",
        alignment: "center",
        border: [true, false, true, true],
      },
      {
        text: "(2)",
        alignment: "center",
        border: [true, false, true, true],
      },
      {
        text: "(3)",
        alignment: "center",
        border: [true, false, true, true],
      },
      {
        text: "(4)",
        alignment: "center",
        border: [true, false, true, true],
      },
      {
        text: "(5)",
        alignment: "center",
        border: [true, false, true, true],
      },
      {
        text: "(6)",
        alignment: "center",
        border: [true, false, true, true],
      },
    ],
  ];

  // Add data rows - if only one entry, use rowSpan like template, otherwise add normally
  if (data.entries.length === 1) {
    const entry = data.entries[0];
    const rowSpan = 6;
    tableBody.push([
      {
        text: entry.travelOrderNo || "",
        alignment: "center",
        rowSpan: rowSpan,
        margin: [0, 20, 0, 0],
      },
      {
        text: entry.inclusiveDates || "",
        alignment: "center",
        rowSpan: rowSpan,
        margin: [0, 20, 0, 0],
      },
      {
        text: entry.projectPlacesVisited || "",
        alignment: "center",
        rowSpan: rowSpan,
        margin: [0, 20, 0, 0],
      },
      {
        text: entry.activitiesUndertaken || "",
        alignment: "center",
        rowSpan: rowSpan,
        margin: [0, 20, 0, 0],
      },
      {
        text: entry.issuesConcerns || "",
        alignment: "center",
        rowSpan: rowSpan,
        margin: [0, 20, 0, 0],
      },
      {
        text: entry.remarksRecommendation || "",
        alignment: "center",
        rowSpan: rowSpan,
        margin: [0, 20, 0, 0],
      },
    ]);
    // Add empty rows for rowSpan
    for (let i = 1; i < rowSpan; i++) {
      tableBody.push(["", "", "", "", "", ""]);
    }
  } else {
    // For multiple entries, add them normally
    data.entries.forEach((entry) => {
      tableBody.push([
        { text: entry.travelOrderNo || "", alignment: "center" },
        { text: entry.inclusiveDates || "", alignment: "center" },
        { text: entry.projectPlacesVisited || "", alignment: "center" },
        { text: entry.activitiesUndertaken || "", alignment: "center" },
        { text: entry.issuesConcerns || "", alignment: "center" },
        { text: entry.remarksRecommendation || "", alignment: "center" },
      ]);
    });
  }

  const docDefinition: TDocumentDefinitions = {
    pageOrientation: "landscape",
    pageSize: "FOLIO",
    pageMargins: [50.4, 54, 50.4, 54],
    defaultStyle: {
      fontSize: 8,
    },
    styles: {
      header: {
        fontSize: 12,
        bold: true,
        alignment: "center",
      },
      title: {
        fontSize: 14,
        bold: true,
        alignment: "center",
        margin: [0, 10, 0, 15],
      },
      tableHeader: {
        fontSize: 8,
        bold: true,
        fillColor: "#ffffff",
        color: "#000000",
        alignment: "center",
        margin: [2, 2, 2, 2],
      },
      tableCell: {
        fontSize: 9,
        margin: [2, 2, 2, 2],
      },
      signatureLabel: {
        fontSize: 9,
        bold: true,
        margin: [0, 15, 0, 5],
      },
      signatureName: {
        fontSize: 9,
        margin: [0, 2, 0, 2],
      },
      signatureTitle: {
        fontSize: 8,
        italics: true,
        margin: [0, 0, 0, 10],
      },
      documentInfo: {
        fontSize: 8,
        margin: [0, 0, 0, 5],
      },
      signatureRow: {
        fontSize: 9,
      },
    },
    content: [
      // Header section with logo and department info - matching template.js structure
      {
        table: {
          widths: ["17%", "*", "26%", "21%"],
          body: [
            [
              {
                rowSpan: 3,
                image: logoImage || "",
                width: 60,
                height: 60,
                alignment: "center",
              },
              {
                text: "DEPARTMENT OF AGRICULTURE",
                alignment: "center",
                bold: true,
                margin: [0, 4.5, 0, 0],
                border: [true, true, true, false],
              },
              {
                text: "Document Code:",
                margin: [0, 4.5, 0, 0],
              },
              {
                text: data.documentCode || "DARFO2.FOD.271",
                margin: [0, 4.5, 0, 0],
              },
            ],
            [
              "",
              {
                text: "REGIONAL FIELD OFFICE NO. 02",
                alignment: "center",
                bold: true,
                margin: [0, 4.5, 0, 0],
                border: [false, false, false, false],
              },
              {
                text: "Effective Date:",
                margin: [0, 4.5, 0, 0],
              },
              {
                text: data.effectivityDate || "7/1/2025",
                margin: [0, 4.5, 0, 0],
              },
            ],
            [
              "",
              { text: "", border: [true, false, true, true] },
              {
                text: "Rev. No.:",
                margin: [0, 4.5, 0, 0],
              },
              {
                text: data.revNo || "0",
                margin: [0, 4.5, 0, 0],
              },
            ],
          ],
        },
      },
      // Title - matching template.js
      {
        text: "POST TRAVEL REPORT",
        bold: true,
        fontSize: 9,
        alignment: "center",
        margin: [0, 25, 0, 9.1],
      },
      // Main table - matching template.js structure
      {
        table: {
          headerRows: 2,
          heights: [10, 3, 45],
          widths: [47, 76, 115, 166, 210, "*"],
          body: tableBody,
        },
      },
      // Signatures section - matching template.js structure
      {
        layout: "noBorders",
        table: {
          headerRows: 1,
          heights: [20, 20],
          widths: [132, 115, 166, 210, "*"],
          body: [
            [
              "Prepared by:",
              "",
              "Reviewed by:",
              "Recommending Approval:",
              "Approved by:",
            ],
            [
              {
                stack: [
                  {
                    text: (data.signatures.preparedBy.name || "").toUpperCase(),
                    alignment: "center",
                    bold: true,
                    decoration: "underline",
                  },
                  {
                    text: data.signatures.preparedBy.title || "",
                    alignment: "center",
                    margin: [0, 5, 0, 0],
                  },
                ],
              },
              "",
              {
                stack: [
                  {
                    text: data.signatures.reviewedBy.name || "",
                    alignment: "center",
                    bold: true,
                    decoration: "underline",
                  },
                  {
                    text: data.signatures.reviewedBy.title || "",
                    alignment: "center",
                    margin: [0, 5, 0, 0],
                  },
                ],
              },
              {
                stack: [
                  {
                    text: data.signatures.recommendingApproval.name || "",
                    alignment: "center",
                    bold: true,
                    decoration: "underline",
                  },
                  {
                    text: data.signatures.recommendingApproval.title || "",
                    alignment: "center",
                    margin: [0, 5, 0, 0],
                  },
                ],
              },
              {
                stack: [
                  {
                    text: data.signatures.approvedBy.name || "",
                    alignment: "center",
                    bold: true,
                    fontSize: 6,
                    decoration: "underline",
                  },
                  {
                    text: data.signatures.approvedBy.title || "",
                    alignment: "center",
                    fontSize: 6,
                    margin: [0, 5, 0, 0],
                  },
                ],
              },
            ],
          ],
        },
        pageBreak: uploadedImages.length > 0 ? "after" : undefined,
      },
      // Second page content - only if images exist
      ...(uploadedImages.length > 0
        ? [
            // Header section for second page
            {
              table: {
                widths: ["17%", "*", "26%", "21%"],
                body: [
                  [
                    {
                      rowSpan: 3,
                      image: logoImage || "",
                      width: 60,
                      height: 60,
                      alignment: "center" as const,
                    },
                    {
                      text: "DEPARTMENT OF AGRICULTURE",
                      alignment: "center" as const,
                      bold: true,
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                      border: [true, true, true, false] as [boolean, boolean, boolean, boolean],
                    },
                    {
                      text: "Document Code:",
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                    },
                    {
                      text: data.documentCode || "DARFO2.FOD.271",
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                    },
                  ],
                  [
                    "",
                    {
                      text: "REGIONAL FIELD OFFICE NO. 02",
                      alignment: "center" as const,
                      bold: true,
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                      border: [false, false, false, false] as [boolean, boolean, boolean, boolean],
                    },
                    {
                      text: "Effective Date:",
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                    },
                    {
                      text: data.effectivityDate || "7/1/2025",
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                    },
                  ],
                  [
                    "",
                    { text: "", border: [true, false, true, true] as [boolean, boolean, boolean, boolean] },
                    {
                      text: "Rev. No.:",
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                    },
                    {
                      text: data.revNo || "0",
                      margin: [0, 4.5, 0, 0] as [number, number, number, number],
                    },
                  ],
                ],
              },
            },
            // Page title for second page
            {
              text: "POST TRAVEL REPORT",
              bold: true,
              fontSize: 9,
              alignment: "center" as const,
              margin: [0, 25, 0, 9.1] as [number, number, number, number],
            },
            // Images table
            {
              table: {
                heights: [210],
                widths: ["33.3%", "33.3%", "33.3%"],
                body: [
                  [
                    uploadedImages[0]
                      ? { image: uploadedImages[0], width: 150, height: 210 }
                      : "",
                    uploadedImages[1]
                      ? { image: uploadedImages[1], width: 150, height: 210 }
                      : "",
                    uploadedImages[2]
                      ? { image: uploadedImages[2], width: 150, height: 210 }
                      : "",
                  ],
                ],
              },
            },
            // Project information table
            {
              table: {
                widths: [132, 115, 166, 210, "*"],
                body: [
                  [
                    {
                      text: `Project Title/Activity: ${data.projectTitle || ""}`,
                      colSpan: 2,
                    },
                    "",
                    {
                      text: `Location: ${data.location || ""}`,
                      colSpan: 2,
                    },
                    "",
                    `ICC/FCA/LGU Name: ${data.iccFcaLguName || ""}`,
                  ],
                  [
                    { text: "", colSpan: 2 },
                    "",
                    { text: "", colSpan: 2 },
                    "",
                    { text: "" },
                  ],
                ],
              },
            },
            // Signatures section for second page
            {
              layout: "noBorders",
              table: {
                headerRows: 1,
                heights: [20, 20],
                widths: [132, 115, 166, 210, "*"],
                body: [
                  [
                    { text: "Prepared by:", colSpan: 2 },
                    "",
                    "Reviewed by:",
                    "Recommending Approval:",
                    "Approved by:",
                  ],
                  [
                    {
                      stack: [
                        {
                          text: (data.signatures.preparedBy.name || "").toUpperCase(),
                          alignment: "center" as const,
                          bold: true,
                          decoration: "underline" as const,
                        },
                        {
                          text: data.signatures.preparedBy.title || "",
                          alignment: "center" as const,
                          margin: [0, 5, 0, 0] as [number, number, number, number],
                        },
                      ],
                    },
                    "",
                    {
                      stack: [
                        {
                          text: data.signatures.reviewedBy.name || "",
                          alignment: "center" as const,
                          bold: true,
                          decoration: "underline" as const,
                        },
                        {
                          text: data.signatures.reviewedBy.title || "",
                          alignment: "center" as const,
                          margin: [0, 5, 0, 0] as [number, number, number, number],
                        },
                      ],
                    },
                    {
                      stack: [
                        {
                          text: data.signatures.recommendingApproval.name || "",
                          alignment: "center" as const,
                          bold: true,
                          decoration: "underline" as const,
                        },
                        {
                          text: data.signatures.recommendingApproval.title || "",
                          alignment: "center" as const,
                          margin: [0, 5, 0, 0] as [number, number, number, number],
                        },
                      ],
                    },
                    {
                      stack: [
                        {
                          text: data.signatures.approvedBy.name || "",
                          alignment: "center" as const,
                          bold: true,
                          fontSize: 6,
                          decoration: "underline" as const,
                        },
                        {
                          text: data.signatures.approvedBy.title || "",
                          alignment: "center" as const,
                          fontSize: 6,
                          margin: [0, 5, 0, 0] as [number, number, number, number],
                        },
                      ],
                    },
                  ],
                ],
              },
            },
          ]
        : []),
    ],
  };

  return docDefinition;
}

// Main component
type PrintPostTravelProps = {
  data: PostTravelReportData;
  btnName?: string;
  variant?: "default" | "outline" | "ghost";
  size?: "default" | "sm" | "lg" | "icon";
};

export default function PrintPostTravel({
  data,
  btnName = "Export PDF",
  variant = "outline",
  size = "sm",
}: PrintPostTravelProps) {
  const [isPrinting, setIsPrinting] = useState(false);
  const [isDownloading, setIsDownloading] = useState(false);

  const handleGeneratePDF = async () => {
    setIsPrinting(true);
    try {
      const pdfMake = await getPdfMake();
      const docDefinition = await generatePostTravelReportPDF(data);
      
      // Use getBlob to avoid popup blocker issues
      const pdfDoc = pdfMake.createPdf(docDefinition);
      const blob = await new Promise<Blob>((resolve, reject) => {
        pdfDoc.getBlob((blob: Blob) => {
          if (blob) {
            resolve(blob);
          } else {
            reject(new Error("Failed to generate PDF blob"));
          }
        });
      });
      
      // Create blob URL and open in new window
      const blobUrl = URL.createObjectURL(blob);
      
      // Try to open in new window
      const newWindow = window.open(blobUrl, '_blank');
      
      if (!newWindow || newWindow.closed || typeof newWindow.closed === 'undefined') {
        // Popup blocked - fallback to download
        const link = document.createElement('a');
        link.href = blobUrl;
        link.download = `post-travel-report-${Date.now()}.pdf`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }
      
      // Clean up blob URL after a delay
      setTimeout(() => {
        URL.revokeObjectURL(blobUrl);
      }, 1000);
    } catch (error) {
      console.error("Error generating PDF:", error);
      alert("Failed to generate PDF. Please try again.");
    } finally {
      setIsPrinting(false);
    }
  };

  const handleDownloadPDF = async () => {
    setIsDownloading(true);
    try {
      const pdfMake = await getPdfMake();
      const docDefinition = await generatePostTravelReportPDF(data);
      pdfMake
        .createPdf(docDefinition)
        .download(`post-travel-report-${Date.now()}.pdf`);
    } catch (error) {
      console.error("Error downloading PDF:", error);
    } finally {
      setIsDownloading(false);
    }
  };

  return (
    <div className="flex items-center gap-2">
      <Button
        variant={variant}
        size={size}
        className="flex items-center gap-2"
        onClick={handleGeneratePDF}
        disabled={isPrinting || isDownloading}
      >
        {isPrinting ? (
          <>
            <Loader2 className="animate-spin" />
            Generating...
          </>
        ) : (
          <>
            {btnName} <Printer />
          </>
        )}
      </Button>
      <Button
        variant={variant}
        size={size}
        className="flex items-center gap-2"
        onClick={handleDownloadPDF}
        disabled={isPrinting || isDownloading}
      >
        {isDownloading ? (
          <>
            <Loader2 className="animate-spin" />
            Downloading...
          </>
        ) : (
          <>
            Download <Download />
          </>
        )}
      </Button>
    </div>
  );
}



