{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext", "WebWorker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "worker/**/*.ts", "app/field-technician/dashboard/layout.tsx", "app/field-technician/projects/[projectID]/monitoring-report/loading.tsx.bak", "app/dashboard/projects/[projectID]/monitoring-reports/loading.tsx.back", "app/dashboard/projects/[projectID]/field-technicians/loading.tsx.back", "app/field-technician/travel-order/components/travel-order-form.tsx.bak", "components/custom/navbar/custom-navbar copy.tsx.bak", "components/custom/pdf/monitoring-reports-docx.tsx.bak"],
  "exclude": ["node_modules"]
}
